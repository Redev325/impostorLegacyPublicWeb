<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="VS IMPOSTOR LEGACY" file="ImpostorLegacy" packageName="com.motorfrog.impostor" package="com.motorfrog.impostor" main="Main" version="0.2.7" company="MotorFrog" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>
	<!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--Use the HaxeFlixel loading screen on native targets and HTML5 too. -->
	<!-- Use the real HaxeFlixel loading screen now that the default library contains only startup/menu assets. -->
		<!-- Use the standard HaxeFlixel blue loading screen on every target. -->
	<app preloader="flixel.system.FlxPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Engine Config Settings ____________________________ -->

	<!--ENGINE CUSTOMIZATION-->
	<define name="MODS_ALLOWED" if="desktop" />
	<define name="VIDEOS_ALLOWED" if="cpp" />
	<define name="DISCORD_ALLOWED" if="cpp"/>

	<!-- _____________________________ Path Settings ____________________________ -->

	<classpath name="source" />

	<!--Fixes hxvlc using global rather than local. you will need to use hmm/hxpkg to compile this project though-->
	<setenv name="HAXEPATH" value="./"/>

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />
	<set name="BUILD_DIR" value="${BUILD_DIR}-tracy" if="FEATURE_DEBUG_TRACY"/>

	<assets path="LEGACY.md" rename="CHANGELOG.md" if="desktop"/>
	<assets path="content/mods-go-here.txt"/>
	
	<section unless="ASSET_REDIRECT">
		<log info="INCLUDING ASSETS!!" />
		<log info="INCLUDING DLC!!" if="DLC" />

		<!-- HTML5 startup: only title-screen assets are preloaded here. -->
		<assets path="assets/legacy/data" rename="assets/data" library="title" include="introText.txt" preload="true" />
		<assets path="assets/legacy/lang" rename="assets/lang" library="title" include="english.json" preload="true" />
		<assets path="assets/legacy/sounds" rename="assets/sounds" library="title"
			include="confirmMenu.ogg" preload="true" />
		<assets path="assets/legacy/music" rename="assets/music" library="title"
			include="freakyMenu.ogg" preload="true" />
		<assets path="assets/legacy/fonts" rename="assets/fonts" library="title"
			include="vcr.ttf|vcr-srb.ttf" preload="true" />
		<assets path="assets/legacy/images" rename="assets/images" library="title"
			include="logoBumpin.png|logoBumpin.xml|alphabet.png|alphabet.xml" preload="true" />
		<assets path="assets/embeds/images" rename="assets/images" library="title"
			include="cursor.png" preload="true" />
		<assets path="assets/legacy/images/menu/common" rename="assets/images/menu/common" library="title"
			include="starFG.png|starBG.png" preload="true" />
		<assets path="assets/legacy/images/menu/title" rename="assets/images/menu/title" library="title"
			include="startText.png|startText.xml|funkin.png" preload="true" />

		<!-- Main menu assets are loaded only when the title screen hands off to the menu. -->
		<assets path="assets/legacy/images/menu/main" rename="assets/images/menu/main" library="mainmenu" preload="true" embed="false" />
		<assets path="assets/legacy/images/icons" rename="assets/images/icons" library="mainmenu" preload="true" embed="false" />
		<assets path="assets/legacy/images/awards" rename="assets/images/awards" library="mainmenu" preload="true" embed="false" />
		<assets path="assets/legacy/images/menu/common/controls" rename="assets/images/menu/common/controls" library="mainmenu" preload="true" embed="false" />
		<assets path="assets/legacy/sounds" rename="assets/sounds" library="mainmenu"
			include="cancelMenu.ogg|scrollMenu.ogg" preload="true" embed="false" />
		<assets path="assets/legacy/sounds" rename="assets/sounds" library="menus"
			include="clickText.ogg|confirmMenu.ogg|cosmicubePop.ogg|equip.ogg|equipPet.ogg|getbeans.ogg|hover.ogg|kill.ogg|locked.ogg|menu/looksie.ogg|panelAppear.ogg|panelDisappear.ogg|select.ogg|shopbuy.ogg|unlockSong.ogg" preload="true" embed="false" />
		<assets path="assets/legacy/music" rename="assets/music" library="mainmenu" include="finaleMenu.ogg" preload="true" embed="false" />

		<!-- Secondary menu content is loaded on demand after the main menu. -->
		<assets path="assets/legacy/images/menu/story" rename="assets/images/menu/story" library="menus" preload="true" embed="false" />
		<assets path="assets/legacy/images/menu/freeplay" rename="assets/images/menu/freeplay" library="menus" preload="true" embed="false" />
