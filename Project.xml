			create FlxText during onCreatePost. Keep the rest of the font library deferred. -->
		<assets path="assets/legacy/fonts" rename="assets/fonts" library="gameplay"
			include="liber.ttf|liberbold.ttf" preload="true" embed="false" if="html5" />
